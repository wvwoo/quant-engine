# --- Python ---
__pycache__/
*.py[cod]
*.so
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# --- virtualenv (28 packages, ~hundreds of MB) ---
# No trailing slash: in a git worktree .venv is often a SYMLINK to the primary
# checkout's venv, and `.venv/` matches directories only — so `git add -A` cheerfully
# committed an absolute-path symlink pointing outside the repo. Verified, not assumed.
qts_v8/venv/
.venv
.venv/
venv/

# --- live runtime state (regenerated; never a source of truth in git) ---
qts_v8/state/*.db
qts_v8/state/*.db-wal
qts_v8/state/*.db-shm
qts_v8/state/*.json
qts_v8/state/*.jsonl
# session_report.md is regenerated on every run (gitignore has no inline comments)
qts_v8/state/*.md
# A-11: there was no *.log rule, so day_run_20260722.log was TRACKED while the
# block above declared this directory 'regenerated; never a source of truth in
# git'. Phase 5 adds a dated log per session, so this had to land first.
qts_v8/state/*.log

# --- secrets: never commit. Values live in the environment. ---
.env
.env.*
!.env.example
# `*secrets*` protects any file whose NAME suggests it holds key material. It is
# deliberately broad and stays broad — but it also silently swallowed the source
# module that MANAGES secrets: `git add -A` skipped qts_core/secrets.py and
# tests/test_secrets.py while a commit message claimed to add them. Caught by
# `git check-ignore -v`, not by reading. Source files are re-admitted by exact
# path; anything else matching the glob is still ignored.
*secrets*
!qts_core/secrets.py
!tests/test_secrets.py
*.pem
*.key

# --- reference material too large / not source (3.2 MB export + assets) ---
Algorithmic Options Trade Explained - Google Gemini.html
Algorithmic Options Trade Explained - Google Gemini_files/

# --- macOS ---
.DS_Store

# --- provider response cache (regenerated; the *.json rule above does NOT
# --- match a subdirectory — gitignore's * never crosses a '/') ---
qts_v8/state/cache/
*.tmp
qts_v8/state/backtests/

# coverage data (regenerated by ci.sh)
.coverage
.coverage.*

