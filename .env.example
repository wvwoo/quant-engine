# QTS environment — NAMES AND COMMENTS ONLY. Never commit real values.
#
# This file is a template. Copy the lines you need into ~/.config/secrets.env
# (mode 0600) or export them in your shell. The loader (qts_core/secrets.py)
# checks the environment FIRST, then ~/.config/secrets.env, and REFUSES to read
# that file unless its mode is exactly 0600 — with the chmod that fixes it.
#
# Why a file at all, when exports exist: a macOS LaunchAgent inherits none of
# the login shell environment. Keys that only ever live in ~/.zshrc are
# invisible to the unattended runner, so the file is what makes a hands-off
# trading day possible.
#
# Step-by-step acquisition for every key below: KEY_ACQUISITION.md
# Full registry of who reads what, and what happens when it is absent or
# malformed: KEYS.md
#
# Verify your setup afterwards with:  qts doctor
# It prints a verdict per key and NEVER prints a value.

# =============================================================================
# SECRETS — only these two. Both belong to an Alpaca PAPER account.
# =============================================================================

# Alpaca PAPER account key id.
#   Where: https://app.alpaca.markets/paper/dashboard/overview -> API Keys
#          -> "Generate New Keys". Note the /paper/ in that URL: the live
#          dashboard is /brokerage/ and its keys will be REJECTED here by
#          design — the broker's base URL is hardcoded to the paper host.
#   Used by: the paper broker (--broker alpaca_paper) and the Alpaca data
#            provider (--provider alpaca). ONE key pair serves both.
#   Absent:  clean halt, exit code 2, with instructions.
#   Wrong:   clean halt, exit code 2, message says REJECTED (not "missing").
#   Options: paper accounts get options enabled by default; the strategy buys
#            calls, so it needs level 2 or higher. `qts doctor` reads the
#            approved level from GET /v2/account and tells you.
#   Format:  Alpaca documents no prefix, length or charset, so the local check
#            is heuristic only — it catches paste errors, not wrong keys.
APCA_API_KEY_ID=

# Alpaca PAPER account secret, generated together with the id above. Shown once.
APCA_API_SECRET_KEY=

# =============================================================================
# OPERATIONAL — not secrets. Every one has a working default; set none of these
# and the system still runs.
# =============================================================================

# Where the loader looks for secrets. Default: ~/.config/secrets.env
# The launchd agent sets this explicitly, because it has no shell profile.
#QTS_SECRETS_FILE=

# Which data provider to use. One of: alpaca, yfinance. Default: yfinance.
# A --provider flag on the command line overrides this for that run.
# yfinance: free, no key, Yahoo's OPRA feed documented 15-min delayed.
# alpaca:   same key as the broker; real-time IEX equity bars, but option
#           quotes come from the free INDICATIVE feed (a derived product).
#           Every MarketView records which feed produced it.
#QTS_DATA_PROVIDER=yfinance

# Path to the SQLite state database. Default: qts_v8/state/paper.db
# One database = one broker backend, enforced at boot: modeled fills and venue
# fills must never blend into one ledger. Use a NEW --db when switching.
#QTS_DB=qts_v8/state/paper.db

# Pin the exchange session date (demos and screenshots). Default: the live
# exchange clock. A malformed value makes /api/overview and /api/execution
# answer 500 — set it only deliberately, and unset it afterwards.
#QTS_SESSION_DATE=

# Where backtest artifacts are written and read. Default: a package-anchored
# path, deliberately NOT cwd-relative — a relative default once made
# /api/backtest confidently deny a result that existed on disk.
#QTS_BACKTEST_DIR=

# Minimum seconds between outbound provider calls, shared per process.
# Default: 1.0 (from StrategyConfig, provenance-tagged).
# Use a plain decimal with a DOT: 1.5, not 1,5. A malformed value is now
# reported by name at the point of use; it used to kill the CLI at import.
#QTS_MIN_REQUEST_INTERVAL_S=1.0

# Owner acknowledgement for live trading. NOT a secret — the expected value is
# a plaintext literal in qts_core/config.py. Setting it correctly still refuses
# to trade: there is no live broker in this codebase, by design. Left here only
# so the gate is discoverable rather than surprising.
#QTS_LIVE_TRADING_OWNER_ACK=

# =============================================================================
# Shell-script knobs (run_session.sh) — exported inline, not usually here.
#   PY             python to use            default .venv/bin/python
#   DB             state database           default qts_v8/state/paper.db
#   REPORT         session report path      default qts_v8/state/session_report.md
#   INTERVAL       seconds between steps    default 300
#   WAIT_FOR_OPEN  wait for the bell        default 0; accepts 1/true/yes/on
# ci.sh knobs: COV_MIN (default 95), COV_FILE_MIN (default 85).
# =============================================================================
